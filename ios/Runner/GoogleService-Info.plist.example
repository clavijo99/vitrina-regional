<?xml version="1.0" encoding="UTF-8"?>
<!-- EJEMPLO. El archivo real lo genera `flutterfire configure` como
     ios/Runner/GoogleService-Info.plist y NO se sube al repositorio. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>API_KEY</key>
	<string>REEMPLAZAR</string>
	<key>GCM_SENDER_ID</key>
	<string>000000000000</string>
	<key>BUNDLE_ID</key>
	<string>com.example.vitrinaRegional</string>
	<key>PROJECT_ID</key>
	<string>tu-proyecto-firebase</string>
	<key>STORAGE_BUCKET</key>
	<string>tu-proyecto-firebase.appspot.com</string>
	<key>GOOGLE_APP_ID</key>
	<string>1:000000000000:ios:0000000000000000</string>
</dict>
</plist>
